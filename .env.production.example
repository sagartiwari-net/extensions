# Production — copy to server as `.env` (NEVER commit .env)
# Panel: https://panel.1clkaccess.store
# Path:  /www/wwwroot/1clkaccess.store/panel
NODE_ENV=production

# --- MySQL (aaPanel DB — already created) ---
# dbname / user / password must match aaPanel
MYSQL_DATABASE=extensionsystem
MYSQL_USER=ExtensionSystem
MYSQL_PASSWORD=CHANGE_ME_USE_AAPANEL_PASSWORD
# If API runs on host (not docker mysql hostname):
# DATABASE_URL=mysql://ExtensionSystem:PASSWORD@127.0.0.1:3306/extensionsystem
# If API runs in docker-compose.prod and mysql is ALSO in compose, use @mysql:3306
# For aaPanel MySQL from docker API container, use host gateway:
# DATABASE_URL=mysql://ExtensionSystem:PASSWORD@172.17.0.1:3306/extensionsystem
DATABASE_URL=mysql://ExtensionSystem:CHANGE_ME@127.0.0.1:3306/extensionsystem

REDIS_URL=redis://127.0.0.1:6379

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_AT_LEAST_32_CHARS
COOKIE_CRYPTO_FALLBACK_KEY=CHANGE_ME_AES_FALLBACK_KEY_32CHARS
COOKIE_SECURE=true
TRUST_PROXY=true
TOKEN_TTL_SECONDS=60

# Public URLs (no trailing slash)
# Panel (admin UI)
ADMIN_ORIGIN=https://panel.1clkaccess.store
CORS_ORIGINS=https://panel.1clkaccess.store
# API must be a public HTTPS origin the extension can reach.
# Preferred: separate subdomain → https://api.1clkaccess.store
# Or same host via nginx /api proxy — then NEXT_PUBLIC_API_BASE=https://panel.1clkaccess.store
NEXT_PUBLIC_API_BASE=https://api.1clkaccess.store
EXTENSION_API_BASE=https://api.1clkaccess.store/api
# Cross-site panel↔api cookies:
COOKIE_SAMESITE=none

# Seed only on first migrate — change immediately after
SEED_MASTER_USER=admin
SEED_MASTER_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Extension ZIP builds on server (optional)
EXTENSION_BUILD_OBFUSCATE=true
UPLOADS_DIR=/www/wwwroot/1clkaccess.store/panel/apps/api/uploads
