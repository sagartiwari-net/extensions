# Copy to .env for local docker + apps

MYSQL_ROOT_PASSWORD=oneclk_root
MYSQL_DATABASE=oneclk_v2
MYSQL_USER=oneclk
MYSQL_PASSWORD=oneclk_pass
MYSQL_PORT=3307

REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=4000
DATABASE_URL=mysql://oneclk:oneclk_pass@127.0.0.1:3307/oneclk_v2
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change-me-local-session-secret-32chars
COOKIE_CRYPTO_FALLBACK_KEY=change-me-local-aes-fallback-key!!
TOKEN_TTL_SECONDS=60

# Admin (Next) — keep hostname consistent (127.0.0.1 ≠ localhost for CORS/cookies)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:4000
ADMIN_ORIGIN=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false
# COOKIE_SAMESITE=none   # only if admin host ≠ API host (requires HTTPS + COOKIE_SECURE=true)
TRUST_PROXY=false

# Seed
SEED_MASTER_USER=admin
SEED_MASTER_PASSWORD=admin123

# Branded extension builds (reseller My extension → download ZIP)
# API + panel origins are system-fixed (not editable in reseller UI)
EXTENSION_API_BASE=http://127.0.0.1:4000/api
# EXTENSION_CONNECTABLE_ORIGINS=https://admin.example.com,https://panel.example.com
# EXTENSION_SOURCE_PATH= # defaults to apps/extension
# UPLOADS_DIR=            # defaults to apps/api/uploads
EXTENSION_BUILD_OBFUSCATE=true
